# Kopieren nach ".env" und Werte anpassen:
#   cp .env.example .env
#
# Diese Datei zeigt, welche Umgebungsvariablen "compose.yaml" erwartet.
# ".env" selbst gehoert NICHT ins Git-Repository (siehe .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=fahrzeugverwaltung
POSTGRES_USER=vehicleadmin
POSTGRES_PASSWORD=change_me_secure_password

# --- Frontend ---
# Port, unter dem die UI auf dem Host erreichbar ist
FRONTEND_PORT=8081
